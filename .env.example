# Supabase Dashboard -> Connect -> Transaction pooler (port 6543, for Vercel/serverless)
# or Session pooler (port 5432). Replace [YOUR-PASSWORD] with the DB password.
# Note: if the password has @ & # ? or space, percent-encode it (@ -> %40).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
# To turn off ssl locally: PGSSLMODE=disable
# PGSSLMODE=
