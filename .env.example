# Supabase Dashboard -> Connect -> Transaction pooler (port 6543, Vercel/serverless ke liye)
# ya Session pooler (port 5432). [YOUR-PASSWORD] ki jagah DB password dalo.
# Note: password me @ & # ? space ho to percent-encode karo (@ -> %40).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
# Local me ssl band karna ho to: PGSSLMODE=disable
# PGSSLMODE=
